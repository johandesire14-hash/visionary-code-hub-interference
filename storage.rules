rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /project-assets/{ownerUid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/zip|audio/.*|video/.*|text/.*');
    }
  }
}
